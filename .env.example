# Postgres (Neon) — connection string do banco
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js — gere com `npx auth secret` ou `openssl rand -base64 33`
AUTH_SECRET=""

# Vercel Blob — token de leitura/escrita (criado ao provisionar um Blob store na Vercel)
BLOB_READ_WRITE_TOKEN=""

# Usado pelo script de criação do admin inicial (prisma/create-admin.ts)
ADMIN_EMAIL="admin@feira.com.br"
ADMIN_PASSWORD=""
