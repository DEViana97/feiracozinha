# Postgres (Neon) - connection string do banco
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js - gere com `npx auth secret` ou `openssl rand -base64 33`
AUTH_SECRET=""

# Vercel Blob - token de leitura/escrita (criado ao provisionar um Blob store na Vercel)
BLOB_READ_WRITE_TOKEN=""

# Usado pelo script de criação do admin inicial (prisma/create-admin.ts)
ADMIN_EMAIL="admin@feira.com.br"
ADMIN_PASSWORD=""

# Telegram - bot que avisa sobre novas reservas (crie com @BotFather; chat id: mande uma
# mensagem ao bot e abra https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp Cloud API (webhook em /api/whatsapp/webhook)
WHATSAPP_VERIFY_TOKEN=""
# Opcional: chave secreta do app na Meta, para validar a assinatura dos avisos
WHATSAPP_APP_SECRET=""
# ID do numero que envia (nao e o telefone) e token de acesso da Meta, para confirmar reservas ao cliente
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_MESSAGE_TOKEN=""
# Opcional: modelo aprovado e idioma (padrao: hello_world / en_US)
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG=""
# Se o modelo usa variaveis nomeadas, os nomes na ordem (ex.: nome,data,horario,pessoas)
WHATSAPP_TEMPLATE_PARAM_NAMES=""
